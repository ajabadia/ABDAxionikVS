<SCRIPT name="onExpression()" script="if (y >= 0.5)
{
	midiout(0,{0xb0,1,range(((y[0]-0.5)*2),0,127)});
}
else
{
	midiout(0,{0xb0,2,range(((0.5-y[0])*2),0,127)});
}" trigger_script="y[0]" trigger_type="0" trigger="1" osc_message="/Sp2L2_Joystick/onExpression" midi_message="0x90,0x90,0,0" midi_target="-1" flag="0"/>
